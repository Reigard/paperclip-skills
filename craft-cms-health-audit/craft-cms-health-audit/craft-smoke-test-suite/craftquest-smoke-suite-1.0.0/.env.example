# Copy to .env for local runs, or set these as CI secrets.
# .env is gitignored — never commit real values.

# Override the site under test without editing smoke.config.js
SMOKE_BASE_URL=https://your-site.com

# Slack incoming webhook for failure notifications (see notifications/slack.md)
SMOKE_SLACK_WEBHOOK=

# Optional: enables the authenticated control-panel check in cp.spec.js.
# Leave blank to keep that check skipped (the default).
SMOKE_CP_USERNAME=
SMOKE_CP_PASSWORD=
